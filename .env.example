# TrendCart environment configuration
# Copy to .env and adjust before running.

# SQLite database file.
# Relative paths resolve from prisma/schema.prisma, so "../db/custom.db"
# points to <project root>/db/custom.db
DATABASE_URL="file:../db/custom.db"

# Secret used to sign admin session tokens (HMAC).
# Generate a strong one: openssl rand -hex 32
ADMIN_SECRET="change-me-to-a-long-random-string"
